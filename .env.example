# Copier en .env (jamais versionné) puis `chmod 600 .env`.

# Serveur d'inférence local compatible OpenAI (llama.cpp)
LLAMA_SERVER_URL=http://localhost:8080/v1
MODEL_NAME=qwen3.8:latest

# Dossier de sortie iLEAPP analysé par défaut (sinon : argument de la ligne de commande)
CASE_PATH=

# Langfuse auto-hébergé (traces). Sans ces clés, l'exécution n'est simplement pas tracée.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Réglages facultatifs (valeurs par défaut indiquées)
# RUNS_DIR=runs              dossier des exécutions
# CHUNK_TOKENS=8000          données par lot, en tokens (le contexte réel est mesuré sur le serveur)
# LLM_PARALLEL=4             appels simultanés au modèle (slots du serveur d'inférence)
# MAX_FINDINGS=25            au-delà, les constats d'un domaine sont condensés
# CORRELATION_LOOKUPS=0      tours de recherche accordés à l'agent de corrélation
# MAX_FIELD_CHARS=1000       longueur max d'un champ transmis au modèle
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_S=3600
# LLM_SEED=0                 graine de tirage
# LLM_CONTAINER=llama-server conteneur Docker du serveur d'inférence, décrit dans le manifeste
# CTX_TOKENS=16384 / CHARS_PER_TOKEN=2.0   utilisés seulement si le serveur ne répond pas à la mesure

# Le traçage LangSmith (cloud) est désactivé dans le code : aucune variable ne le réactive.
