# Configuration du serveur d'inférence (aucun secret ici). Valeurs en service le 2026-09-30.

# Fichier du modèle. Un blob Ollama porte son SHA-256 dans son nom : c'est l'identité du modèle.
MODEL_FILE=/home/<utilisateur>/.ollama/models/blobs/sha256-68f0041ed409b99e3620d92c7693029361cef0fb3f13b141d61e25f5a9cd6818
MODEL_ALIAS=qwen3.8:latest

# Contexte total, partagé entre les slots : 131072 / 4 = 32768 tokens par appel.
CTX_TOTAL=131072
PARALLEL=4

# RTX 3080 (10 Go) : 24 couches sur le GPU, le reste sur le CPU. C'est ce qui fixe la vitesse
# (environ 3,5 tokens/s en génération, mesuré) ; à revoir avec les chiffres de l'évaluation.
GPU_LAYERS=24
THREADS=24
KV_CACHE_TYPE=q4_0
