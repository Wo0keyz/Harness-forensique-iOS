# CPU seul : le GPU de 10 Go porte le serveur principal (et le pilote NVIDIA attend un redémarrage).
# Pour lui donner l'attention du MoE (lecture du prompt bien plus rapide) : réservation GPU comme dans
# docker-compose.yml, GPU_LAYERS=99 et l'option --n-cpu-moe N (experts restant sur le CPU, à mesurer).
GPU_LAYERS=0
THREADS=24
